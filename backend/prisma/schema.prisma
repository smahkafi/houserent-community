generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  fullName         String
  phone            String   @unique
  email            String?  @unique
  password         String?
  role             Role     @default(TENANT)
  isActive         Boolean  @default(true)
  isApproved       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  houses           House[]             @relation("LandlordHouses")
  bookings         Booking[]           @relation("TenantBookings")
  landlordBookings Booking[]           @relation("LandlordBookings")

  reports      CommunityReport[] @relation("ResidentReports")
}

model House {
  id              Int         @id @default(autoincrement())
  title           String
  description     String
  houseNo         String
  plotNo          String?
  roadNo          String?
  address         String?
  area            String
  mapLocation     String
  unionName       String?
  imageUrl        String?
  totalFloors     Int?
  status          HouseStatus @default(PENDING)
  rejectionReason String?
  isPublished     Boolean     @default(false)
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  deleteReason    String?
  deletedById     Int?
  restoreRequested    Boolean   @default(false)
  restoreRequestedAt  DateTime?
  restoreReason       String?
  restoreReviewedAt   DateTime?
  restoreReviewNote   String?
  restoreReviewedById Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  landlordId      Int
  landlord        User        @relation("LandlordHouses", fields: [landlordId], references: [id])

  rentalUnits     RentalUnit[]
}

model RentalUnit {
  id                Int         @id @default(autoincrement())
  title             String
  description       String?
  rentAmount        Float
  bedrooms          Int
  bathrooms         Int
  attachedBathrooms Int?
  commonBathrooms   Int?
  balconies         Int?
  floorNo           Int?
  sizeInSqft        Float?
  availableFrom     DateTime?
  isAvailable       Boolean     @default(true)
  status            UnitStatus  @default(PENDING)
  rejectionReason   String?
  isPublished       Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  houseId           Int
  house             House       @relation(fields: [houseId], references: [id])

  bookings          Booking[]
}

model Booking {
  id              Int           @id @default(autoincrement())
  tenantId        Int
  landlordId      Int
  rentalUnitId    Int
  message         String
  moveInDate      DateTime
  status          BookingStatus @default(PENDING)
  rejectionReason String?
  landlordNote    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          User            @relation("TenantBookings", fields: [tenantId], references: [id])
  landlord        User            @relation("LandlordBookings", fields: [landlordId], references: [id])
  rentalUnit      RentalUnit      @relation(fields: [rentalUnitId], references: [id])
  rentalAgreement RentalAgreement?
}

model RentalAgreement {
  id        Int      @id @default(autoincrement())
  bookingId Int      @unique
  pdfUrl    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking   Booking  @relation(fields: [bookingId], references: [id])
}

model AppSetting {
  id                     Int      @id @default(1)
  agreementFooterEnabled Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum Role {
  TENANT
  LANDLORD
  RESIDENT
  ADMIN
  SUPER_ADMIN
}

enum HouseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UnitStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
}

model CommunityReport {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  category    ReportCategory
  location    String
  imageUrls   Json?
  affectedHouseIds Json?
  status      ReportStatus     @default(PENDING)
  adminNote   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reportedById Int
  reportedBy   User            @relation("ResidentReports", fields: [reportedById], references: [id])
}

enum ReportCategory {
  ROAD
  ELECTRICITY
  WATER
  GAS
  SECURITY
  SANITATION
  OTHER
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}